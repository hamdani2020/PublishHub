{
  "name": "@publishhub/api",
  "version": "0.1.0",
  "private": true,
  "description": "PublishHub API gateway: validates publish requests, enqueues jobs, and serves post state.",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "//dependencies": "Versions are pinned exactly, with no ^ or ~ range, so a build today and a build in six months resolve the same tree (Requirement 6.6). Upgrades are a deliberate commit.",
  "dependencies": {
    "@aws-sdk/client-sqs": "3.1106.0",
    "cors": "2.8.6",
    "dd-trace": "6.10.0",
    "express": "4.22.2",
    "helmet": "8.3.0",
    "ioredis": "5.11.1",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "prom-client": "15.1.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/cors": "2.8.19",
    "@types/express": "4.17.25",
    "@types/node": "20.19.43",
    "eslint": "10.8.1",
    "tsx": "4.23.11",
    "typescript": "5.9.3",
    "typescript-eslint": "8.66.0",
    "vitest": "3.2.7"
  }
}
